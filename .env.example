# --- required ---
# Prowlarr: Settings -> General -> API Key
PROWLARR_KEY=

# --- services (defaults assume container names on a shared docker network) ---
PROWLARR_URL=http://prowlarr:9696
# qBittorrent WebUI. If qBittorrent runs inside a VPN container (e.g. gluetun), use that container's name.
QBIT_URL=http://qbittorrent:8080
QBIT_CATEGORY=roms
# Where qBittorrent saves romseek's downloads, as seen by BOTH qBittorrent and romseek.
QBIT_SAVE_PATH=/data/downloads/roms

# --- RomM ---
# RomM's roms folder as seen by romseek (firmware defaults to the sibling "bios" folder).
ROMM_LIBRARY=/data/media/roms/roms
# ROMM_FIRMWARE=/data/media/roms/bios
# Internal URL romseek uses for the RomM API, and the public URL your users open.
ROMM_URL=http://romm:8080
ROMM_PUBLIC_URL=https://romm.example.com
# Optional: RomM client API token with "View ROMs" + "View platforms" (direct game links),
# plus "Edit ROMs" for the admin game menu (metadata lookup/edit, remove).
ROMM_API_TOKEN=

# --- optional ---
# Hide these Prowlarr indexers (comma-separated names).
EXCLUDED_INDEXERS=LimeTorrents
# Virus-scan gate: file whose mtime = cutoff your scanner has covered. Empty = import immediately.
SCAN_STATE=
POLL_SECONDS=60
# Biggest BIOS file (MB) you can upload in the Platforms & BIOS tab.
# UPLOAD_MAX_MB=1024

# Forward-auth groups (Remote-Groups header) that get the admin game menu.
ADMIN_GROUPS=admins
